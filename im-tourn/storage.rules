rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function image() { return request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /rankings/{rankingId}/entries/{filename} {
      function host() { return request.auth != null && firestore.get(/databases/(default)/documents/rankings/$(rankingId)).data.hostId == request.auth.uid; }
      allow read: if true;
      allow create, update: if host() && image();
      allow delete: if host();
    }
    match /tierLists/{ownerId}/{listId}/{filename} {
      function owner() { return request.auth != null && request.auth.uid == ownerId && firestore.get(/databases/(default)/documents/tierLists/$(listId)).data.ownerId == ownerId; }
      allow read, delete: if owner();
      allow create, update: if owner() && image();
    }
  }
}
